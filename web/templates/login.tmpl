<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-panel">
      <p class="brand-mark">Kala Belajar</p>
      <h1>Masuk ke dashboard</h1>
      <p class="muted">Kelola les privat dengan data yang rapi dan mudah dicek.</p>
      {{ if .Error }}<div class="alert error">{{ .Error }}</div>{{ end }}
      <form method="post" action="/login" class="form-stack">
        <label>Email
          <input type="text" inputmode="email" name="email" value="{{ .Email }}" required autocomplete="email">
        </label>
        <label>Password
          <input type="password" name="password" required autocomplete="current-password">
        </label>
        <button type="submit">Masuk</button>
      </form>
      <p class="switch-link">Belum punya akun? <a href="/register">Daftar dulu</a></p>
    </section>
  </main>
</body>
</html>
