<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body class="dashboard-page">
  <aside class="sidebar">
    <div class="brand-mark light">Kala Belajar</div>
    <nav>
      <a href="/dashboard" class="active">Dashboard</a>
    </nav>
  </aside>
  <main class="dashboard-main">
    <header class="topbar">
      <div>
        <p class="eyebrow">{{ .RoleLabel }}</p>
        <h1>Halo, {{ .User.Name }}</h1>
      </div>
      <form method="post" action="/logout">
        <button class="secondary" type="submit">Keluar</button>
      </form>
    </header>
    <section class="content-panel">
      {{ if .IsSuperAdmin }}
      <div class="admin-nav">
        <a href="/admin/users">User</a>
        <a href="/admin/tutors">Tutor</a>
        <a href="/admin/students">Murid</a>
        <a href="/admin/schedules">Jadwal</a>
        <a href="/admin/activity">Activity Log</a>
      </div>
      <h2>Ringkasan operasional</h2>
      <div class="metrics-grid">
        <a class="metric-card" href="/admin/tutors"><strong>{{ .TotalTutors }}</strong><span>Total Tutor</span></a>
        <a class="metric-card" href="/admin/students"><strong>{{ .TotalStudents }}</strong><span>Total Murid</span></a>
        <a class="metric-card" href="/admin/users?role=parent"><strong>{{ .TotalParents }}</strong><span>Total Parent</span></a>
        <a class="metric-card" href="/admin/schedules?status=active"><strong>{{ .ActiveSchedules }}</strong><span>Jadwal Aktif</span></a>
        <a class="metric-card" href="/admin/tutors?status=unverified"><strong>{{ .PendingTutors }}</strong><span>Pending Approval</span></a>
      </div>
      {{ if eq .ActivityCount 0 }}
      <div class="empty-state">Belum ada aktivitas terbaru.</div>
      {{ else }}
      <p class="muted">Ada {{ .ActivityCount }} aktivitas tercatat. Buka Activity Log untuk detail audit.</p>
      {{ end }}
      {{ else }}
      {{ if .IsTutor }}
      <h2>Ringkasan Mengajar</h2>
      <div class="metrics-grid">
        <a class="metric-card" href="/tutor/schedules"><strong>{{ .ScheduleCount }}</strong><span>Jadwal Aktif</span></a>
        <div class="metric-card"><strong>{{ .StudentCount }}</strong><span>Murid Aktif</span></div>
      </div>
      <p class="muted">Buka Jadwal Saya untuk melihat murid, jam, lokasi, dan status jadwal.</p>
      {{ else if .IsParent }}
      <h2>Ringkasan Anak</h2>
      <div class="metrics-grid">
        <a class="metric-card" href="/parent/schedules"><strong>{{ .ScheduleCount }}</strong><span>Jadwal Anak</span></a>
        <div class="metric-card"><strong>{{ .ChildCount }}</strong><span>Anak Terdaftar</span></div>
      </div>
      <p class="muted">Jadwal nonaktif tidak ditampilkan di ringkasan Parent.</p>
      {{ else }}
      <h2>Ringkasan awal</h2>
      <p class="muted">Fondasi dashboard sudah aktif. Data operasional akan muncul sesuai role kamu.</p>
      <div class="empty-state">Belum ada aktivitas terbaru.</div>
      {{ end }}
      {{ end }}
    </section>
  </main>
</body>
</html>
