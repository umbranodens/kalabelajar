<!doctype html>
<html lang="id">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ .Title }}</title><link rel="stylesheet" href="/static/css/app.css"></head>
<body class="dashboard-page mobile-role">
  <aside class="sidebar"><div class="brand-mark light">Kala Belajar</div><nav><a href="/dashboard">Dashboard</a><a href="/parent/schedules">Jadwal Anak</a><a class="active" href="/parent/reports">Laporan Progres</a></nav></aside>
  <main class="dashboard-main">
    <header class="topbar"><div><p class="eyebrow">Parent</p><h1>Laporan Progres Anak</h1></div><form method="post" action="/logout"><button class="secondary" type="submit">Keluar</button></form></header>
    <section class="content-panel">
      <form class="filter-bar" method="get"><select name="student_id"><option value="">Semua anak</option>{{ range .Students }}<option value="{{ .ID }}">{{ .Name }}</option>{{ end }}</select><button type="submit">Filter</button></form>
      {{ if .Reports }}
      <div class="schedule-card-list">
        {{ range .Reports }}
        <article class="schedule-card report-body">
          <p class="eyebrow">{{ .Student.Name }} · {{ .LessonSession.DateLabel }}</p>
          <h2>{{ .LessonSession.SubjectLabel }}</h2>
          <p><strong>Materi:</strong> {{ .MaterialSummary }}</p>
          <p><strong>Progres:</strong> {{ if .ProgressSummary }}{{ .ProgressSummary }}{{ else }}-{{ end }}</p>
          <p><strong>PR / tugas:</strong> {{ if .Homework }}{{ .Homework }}{{ else }}-{{ end }}</p>
          <p><strong>Kendala:</strong> {{ if .IssueNotes }}{{ .IssueNotes }}{{ else }}-{{ end }}</p>
          <p><strong>Saran latihan:</strong> {{ if .HomePracticeSuggestion }}{{ .HomePracticeSuggestion }}{{ else }}-{{ end }}</p>
        </article>
        {{ end }}
      </div>
      {{ else }}
      <div class="empty-state">Laporan belum tersedia.</div>
      {{ end }}
    </section>
  </main>
</body>
</html>
