<!doctype html>
<html lang="id">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ .Title }}</title><link rel="stylesheet" href="/static/css/app.css"></head>
<body class="dashboard-page mobile-role">
  <aside class="sidebar"><div class="brand-mark light">Kala Belajar</div><nav><a href="/dashboard">Dashboard</a>{{ if eq .RoleLabel "Tutor" }}<a class="active" href="/tutor/schedules">Jadwal Saya</a>{{ else }}<a class="active" href="/parent/schedules">Jadwal Anak</a>{{ end }}</nav></aside>
  <main class="dashboard-main">
    <header class="topbar">
      <div><p class="eyebrow">{{ .RoleLabel }}</p><h1>{{ .ScheduleTitle }}</h1></div>
      <form method="post" action="/logout"><button class="secondary" type="submit">Keluar</button></form>
    </header>
    <section class="content-panel">
      {{ if .Schedules }}
      <div class="schedule-card-list">
        {{ range .Schedules }}
        <article class="schedule-card">
          <div><p class="eyebrow">{{ .DayLabel }}</p><h2>{{ .SubjectLabel }}</h2></div>
          <p><strong>{{ .StartTime }} - {{ .EndTime }}</strong></p>
          <p>{{ .Student.Name }} bersama {{ .Tutor.User.Name }}</p>
          <p class="muted">{{ .LocationLabel }} · {{ .StatusLabel }}</p>
        </article>
        {{ end }}
      </div>
      {{ else }}
      <div class="empty-state">{{ .EmptyText }}</div>
      {{ end }}
    </section>
  </main>
</body>
</html>
