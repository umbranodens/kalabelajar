<!doctype html>
<html lang="id">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ .Title }}</title><link rel="stylesheet" href="/static/css/app.css"></head>
<body class="dashboard-page">
  <aside class="sidebar"><div class="brand-mark light">Kala Belajar</div><nav><a href="/dashboard">Dashboard</a><a href="/admin/users">User</a><a class="active" href="/admin/tutors">Tutor</a><a href="/admin/students">Murid</a><a href="/admin/schedules">Jadwal</a><a href="/admin/activity">Activity Log</a></nav></aside>
  <main class="dashboard-main">
    <header class="topbar"><div><p class="eyebrow">Super Admin</p><h1>Manajemen Tutor</h1></div></header>
    <section class="content-panel">
      <form class="filter-bar" method="get"><select name="status"><option value="">Semua status</option><option value="verified">Terverifikasi</option><option value="unverified">Belum Terverifikasi</option><option value="inactive">Nonaktif</option></select><button type="submit">Filter</button></form>
      {{ if .Tutors }}
      <div class="table-wrap"><table><thead><tr><th>Nama</th><th>Email</th><th>Subject</th><th>Status</th><th>Verifikasi</th><th>Aksi</th></tr></thead><tbody>
        {{ range .Tutors }}
        <tr><td>{{ .User.Name }}</td><td>{{ .User.Email }}</td><td>{{ .Subjects }}</td><td>{{ if .User.IsActive }}Aktif{{ else }}Nonaktif{{ end }}</td><td>{{ if .IsVerified }}Terverifikasi{{ else }}Belum Terverifikasi{{ end }}</td><td>{{ if .IsVerified }}-{{ else }}<form method="post" action="/admin/tutors/{{ .ID }}/verify"><button type="submit">Verifikasi Tutor</button></form>{{ end }}</td></tr>
        {{ end }}
      </tbody></table></div>
      {{ else }}<div class="empty-state">Belum ada tutor yang cocok.</div>{{ end }}
    </section>
  </main>
</body>
</html>
