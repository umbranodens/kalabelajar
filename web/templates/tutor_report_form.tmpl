<!doctype html>
<html lang="id">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ .Title }}</title><link rel="stylesheet" href="/static/css/app.css"><script defer src="/static/js/app.js"></script></head>
<body class="dashboard-page mobile-role">
  <aside class="sidebar"><div class="brand-mark light">Kala Belajar</div><nav><a href="/dashboard">Dashboard</a><a class="active" href="/tutor/sessions">Riwayat Mengajar</a></nav></aside>
  <main class="dashboard-main">
    <header class="topbar"><div><p class="eyebrow">Tutor</p><h1>Isi Laporan</h1></div><a href="/tutor/sessions">Kembali</a></header>
    <section class="content-panel">
      <p class="muted">{{ .Session.Student.Name }} · {{ .Session.DateLabel }} · {{ .Session.TimeLabel }}</p>
      {{ if .Error }}<div class="alert error">{{ .Error }}</div>{{ end }}
      <form class="report-form" method="post" action="/tutor/sessions/{{ .Session.ID }}/report">
        <label>Status<select name="status" required><option value="completed">Selesai</option><option value="canceled">Dibatalkan</option><option value="student_absent">Murid Tidak Hadir</option><option value="follow_up_required">Perlu Tindak Lanjut</option><option value="rescheduled">Dijadwalkan Ulang</option><option value="scheduled">Terjadwal</option></select></label>
        <label>Materi yang dibahas<textarea name="material_summary" rows="5" placeholder="Contoh: Pecahan campuran dan latihan soal..." required>{{ if .Session.Report }}{{ .Session.Report.MaterialSummary }}{{ end }}</textarea></label>
        <label>Progres murid<textarea name="progress_summary" rows="4">{{ if and .Session.Report .Session.Report.ProgressSummary }}{{ .Session.Report.ProgressSummary }}{{ end }}</textarea></label>
        <label>PR / tugas<textarea name="homework" rows="3">{{ if and .Session.Report .Session.Report.Homework }}{{ .Session.Report.Homework }}{{ end }}</textarea></label>
        <label>Catatan kendala<textarea name="issue_notes" rows="3">{{ if and .Session.Report .Session.Report.IssueNotes }}{{ .Session.Report.IssueNotes }}{{ end }}</textarea></label>
        <label>Saran latihan di rumah<textarea name="home_practice_suggestion" rows="3">{{ if and .Session.Report .Session.Report.HomePracticeSuggestion }}{{ .Session.Report.HomePracticeSuggestion }}{{ end }}</textarea></label>
        <label class="inline-check"><input type="checkbox" name="publish" checked> Terbitkan untuk Parent</label>
        <button type="submit">Kirim Laporan</button>
      </form>
    </section>
  </main>
</body>
</html>
