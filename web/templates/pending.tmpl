<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-panel">
      <p class="brand-mark">Kala Belajar</p>
      <h1>Menunggu role</h1>
      <p class="muted">Hai {{ .User.Name }}, akun kamu sudah dibuat. Admin akan memberi akses yang sesuai.</p>
      <form method="post" action="/logout" class="form-stack">
        <button type="submit">Keluar</button>
      </form>
    </section>
  </main>
</body>
</html>
