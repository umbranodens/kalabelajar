<!doctype html>
<html lang="id">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ .Title }}</title><link rel="stylesheet" href="/static/css/app.css"></head>
<body class="dashboard-page">
  <aside class="sidebar"><div class="brand-mark light">Kala Belajar</div><nav><a href="/dashboard">Dashboard</a><a href="/admin/users">User</a><a href="/admin/tutors">Tutor</a><a href="/admin/students">Murid</a><a href="/admin/schedules">Jadwal</a><a class="active" href="/admin/activity">Activity Log</a></nav></aside>
  <main class="dashboard-main">
    <header class="topbar"><div><p class="eyebrow">Super Admin</p><h1>Activity Log</h1></div></header>
    <section class="content-panel">
      <form class="filter-bar" method="get"><input type="text" name="action" placeholder="Filter action, contoh assign_tutor"><button type="submit">Filter</button></form>
      {{ if .Logs }}
      <div class="table-wrap"><table><thead><tr><th>Waktu</th><th>User</th><th>Action</th><th>Entity</th><th>IP</th></tr></thead><tbody>
        {{ range .Logs }}<tr><td>{{ .CreatedAt }}</td><td>{{ .User.Email }}</td><td>{{ .Action }}</td><td>{{ .EntityType }}</td><td>{{ .IPAddress }}</td></tr>{{ end }}
      </tbody></table></div>
      {{ else }}<div class="empty-state">Belum ada aktivitas terbaru.</div>{{ end }}
    </section>
  </main>
</body>
</html>
